Cell[BoxData[
 RowBox[{
  RowBox[{"skewedVoigt", "[", 
   RowBox[{
   "\[Mu]_", ",", "\[Delta]_", ",", "\[Sigma]_", ",", "skew_", ",", "x_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"VoigtDistribution", "[", 
      RowBox[{"\[Delta]", ",", "\[Sigma]"}], "]"}], ",", 
     RowBox[{"(", 
      RowBox[{"x", "-", "\[Mu]"}], ")"}]}], "]"}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"Erf", "[", 
      FractionBox[
       RowBox[{"skew", 
        RowBox[{"(", 
         RowBox[{"x", "-", "\[Mu]"}], ")"}]}], 
       RowBox[{"\[Sigma]", 
        SqrtBox["2"]}]], "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.7739963483817883`*^9, 3.7739964542427015`*^9}, {
   3.8013545422632694`*^9, 3.8013545444402127`*^9}, 3.80192349238767*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"45c04d4c-dd41-4f40-862b-85e070047e47"],

