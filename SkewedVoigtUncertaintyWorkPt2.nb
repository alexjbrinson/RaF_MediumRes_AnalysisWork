 RowBox[{"skewedVoigt", "[", 
  RowBox[{"\[Mu]", ",", "\[Delta]", ",", "\[Sigma]", ",", "skew", ",", "x"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
