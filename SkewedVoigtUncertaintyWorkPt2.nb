Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"PDF", "[", 
  RowBox[{
   RowBox[{"VoigtDistribution", "[", 
    RowBox[{"\[Delta]", ",", "\[Sigma]"}], "]"}], ",", "x"}], "]"}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.7739961644060745`*^9, 3.77399618899096*^9}, {
   3.773996247790818*^9, 3.773996255240664*^9}, 3.801459122077202*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"93c82570-bc5d-4a7c-ad48-2ac978cbf4fc"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}], "+", "\[Delta]"}], 
        ")"}], "2"], 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
    RowBox[{"Erfc", "[", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}], "+", "\[Delta]"}], 
      RowBox[{
       SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}], "+", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "x"}], "+", "\[Delta]"}], ")"}], "2"], 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
    RowBox[{"Erfc", "[", 
     FractionBox[
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", "x"}], "+", "\[Delta]"}], 
      RowBox[{
       SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}]}], 
  RowBox[{"2", " ", 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]], " ", "\[Sigma]"}]]], "Output",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{3.7739961897507524`*^9, 3.7739962562010994`*^9, 
  3.801459122077202*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"e8932732-eae7-46e7-8aca-d173210139b1"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"VoigtDistribution", "[", 
         RowBox[{"1", ",", "\[Sigma]"}], "]"}], ",", "x"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Sigma]", ",", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "1.", ",", "1.5"}], "}"}]}], "}"}]}], "]"}], "//",
     "Evaluate"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
   RowBox[{"Exclusions", "\[Rule]", "None"}], ",", 
   RowBox[{"Filling", "\[Rule]", "Axis"}]}], "]"}]], "Input",
