Cell[BoxData[
 RowBox[{
  RowBox[{"red\[Chi]", "[", 
   RowBox[{"data_", ",", "c_", ",", "p_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pollys", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "c"}], ")"}], "^", "n"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "p"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"fitFunc", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"data", ",", "pollys", ",", "x", ",", 
       RowBox[{"Weights", "\[Rule]", 
        FractionBox["1", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"resids", "=", 
     RowBox[{"fitFunc", "[", "\"\<FitResiduals\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"r\[Chi]sq", "=", 
     FractionBox[
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], 
        RowBox[{"Length", "[", "resids", "]"}]], 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"resids", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ")"}], "2"], 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}]]}], 
      RowBox[{
       RowBox[{"Length", "[", "resids", "]"}], "-", 
       RowBox[{"(", 
        RowBox[{"p", "+", "1"}], ")"}]}]]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.8018863686522636`*^9, 3.8018864643387623`*^9}, {
   3.801886496236335*^9, 3.8018864963512697`*^9}, 3.801886541898363*^9, {
   3.8018865913293877`*^9, 3.8018865915632534`*^9}, {3.8018866381111174`*^9, 
   3.8018866594657707`*^9}, {3.8018867446138477`*^9, 
   3.8018867626374316`*^9}, {3.8018868179562016`*^9, 
   3.8018868328532424`*^9}, {3.8018868948707075`*^9, 3.801886922620706*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"91233493-3cf0-4421-ace7-fda2c27e55cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fitPlot", "[", 
   RowBox[{"data_", ",", "c_", ",", "p_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xDat", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"pollys", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "c"}], ")"}], "^", "n"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "p"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"fitFunc", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"data", ",", "pollys", ",", "x", ",", 
       RowBox[{"Weights", "\[Rule]", 
        FractionBox["1", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"resids", "=", 
     RowBox[{"fitFunc", "[", "\"\<FitResiduals\>\"", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"r\[Chi]sq", "=", 
     FractionBox[
