Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bins", ",", "counts"}], "}"}], "=", 
   RowBox[{"HistogramList", "[", 
    RowBox[{"tSamp", ",", 
     RowBox[{"{", 
      RowBox[{"Table", "[", 
       RowBox[{"f", ",", 
        RowBox[{"{", 
         RowBox[{"f", ",", "13281", ",", "13286", ",", ".01"}], "}"}]}], 
       "]"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xSamp", "=", 
   RowBox[{"smooth", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"bins", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"-", "2"}]}], "]"}], "]"}], "+", 
       RowBox[{"bins", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}]}], "2"], ",", "0"}], "]"}]}], ";", 
  RowBox[{"ySamp", "=", 
   RowBox[{"smooth", "[", 
    RowBox[{"counts", ",", "0"}], "]"}]}], ";", " ", 
  RowBox[{"dSamp", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"xSamp", ",", "ySamp"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xSamp5", "=", 
   RowBox[{"smooth", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"bins", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"-", "2"}]}], "]"}], "]"}], "+", 
       RowBox[{"bins", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}]}], "2"], ",", "5"}], "]"}]}], ";", 
  RowBox[{"ySamp5", "=", 
   RowBox[{"smooth", "[", 
    RowBox[{"counts", ",", "5"}], "]"}]}], ";", " ", 
  RowBox[{"dSamp5", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"xSamp5", ",", "ySamp5"}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"{", 
   RowBox[{"dSamp", ",", "dSamp5"}], "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"counts", "=", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"i", "=", "1"}], 
    RowBox[{"Length", "[", "ySamp", "]"}]], 
   RowBox[{"ySamp", "[", 
    RowBox[{"[", "i", "]"}], "]"}]}]}]}], "Input",
