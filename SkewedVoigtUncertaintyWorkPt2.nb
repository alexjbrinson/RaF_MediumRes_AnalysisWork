            RowBox[{"1", "+", "w", "+", "i"}], ";;", 
            RowBox[{
             RowBox[{"-", "1"}], "-", 
             RowBox[{"(", 
              RowBox[{"w", "-", "i"}], ")"}]}]}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"-", "w"}], ",", "w"}], "}"}]}], "]"}]}]}], ";", 
