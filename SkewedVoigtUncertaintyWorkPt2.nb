  RowBox[{"(", 
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", 
          RowBox[{"-", "w"}]}], "w"], 
        FractionBox["1", 
         RowBox[{
          RowBox[{"Abs", "[", "i", "]"}], "+", "1"}]]}]], 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", 
