Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"Erf", "[", 
      FractionBox[
       RowBox[{"skew", " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "\[Mu]"}], ")"}]}], 
       RowBox[{
        SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Delta]", "-", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", "\[Mu]"}], ")"}]}]}], ")"}], "2"], 
        RowBox[{"2", " ", 
         SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
      RowBox[{"Erfc", "[", 
       FractionBox[
        RowBox[{"\[Delta]", "-", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{"x", "-", "\[Mu]"}], ")"}]}]}], 
        RowBox[{
         SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Delta]", "+", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", "\[Mu]"}], ")"}]}]}], ")"}], "2"], 
        RowBox[{"2", " ", 
         SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
      RowBox[{"Erfc", "[", 
       FractionBox[
        RowBox[{"\[Delta]", "+", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{"x", "-", "\[Mu]"}], ")"}]}]}], 
        RowBox[{
         SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}]}], ")"}]}], 
  RowBox[{"2", " ", 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]], " ", "\[Sigma]"}]]], "Output",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{
  3.7739964873326406`*^9, 3.801447630672442*^9, {3.801459187051649*^9, 
