  RowBox[{
   RowBox[{"skewedVoigt", "[", 
    RowBox[{"0", ",", "1.5", ",", "1", ",", 
     RowBox[{"-", "4"}], ",", "x"}], "]"}], ",", "x"}], "]"}]}], "Input",
