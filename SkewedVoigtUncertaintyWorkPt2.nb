Cell[BoxData[{
 RowBox[{
  RowBox[{"findPolyMax", "[", 
   RowBox[{"dset_", ",", "p_", ",", 
    RowBox[{"{", 
     RowBox[{"guessLBound_", ",", "guessRBound_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", 
     FractionBox[
      RowBox[{"guessLBound", "+", "guessRBound"}], "2"]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"pollys", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "g"}], ")"}], "^", "n"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "p"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"fitFunc", "=", 
     RowBox[{"Fit", "[", 
      RowBox[{"dset", ",", "pollys", ",", "x"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"nmaxFit", "=", 
     RowBox[{
      RowBox[{"NMaximize", "[", 
