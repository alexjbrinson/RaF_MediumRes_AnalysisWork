Cell[BoxData[
 RowBox[{
  RowBox[{"isotopePolySigmaCalculator", "[", 
   RowBox[{"m_", ",", "parms_", ",", 
    RowBox[{"{", 
     RowBox[{"kRange1_", ",", "kRange2_", ",", "res_"}], "}"}], ",", 
    "peakRanges_", ",", "bin_", ",", "guessRanges_", ",", "p_", ",", 
    "nSamps_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freqs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"k", ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "kRange1", ",", "kRange2", ",", "res"}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"mWeights", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"trooF", "[", 
        RowBox[{"parms", ",", "k"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "kRange1", ",", "kRange2", ",", "res"}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"mTotSamp", "=", 
     RowBox[{"RandomChoice", "[", 
      RowBox[{
       RowBox[{"mWeights", "\[Rule]", "freqs"}], ",", 
       RowBox[{"massCounts", "[", "m", "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"countsList", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"counts3", ",", "counts2", ",", "counts1", ",", "counts0"}], 
       "}"}], "=", 
      RowBox[{
       RowBox[{"HistogramList", "[", 
        RowBox[{"mTotSamp", ",", 
         RowBox[{"{", "peakRanges", "}"}]}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"freqsi", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"k", ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"peakRanges", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"peakRanges", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", "res"}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mWeights", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"trooF", "[", 
            RowBox[{"parms", ",", "k"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"peakRanges", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"peakRanges", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", "res"}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mPolyEsts", "=", 
         RowBox[{"SubSampleDistMaker4", "[", 
          RowBox[{"mWeights", ",", "freqsi", ",", 
           RowBox[{"countsList", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"peakRanges", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"peakRanges", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", "bin"}], "}"}], 
           ",", 
           RowBox[{"{", "0", "}"}], ",", "p", ",", 
           RowBox[{"guessRanges", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "nSamps"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[ScriptCapitalH]i", "=", 
         RowBox[{"HistogramDistribution", "[", "mPolyEsts", "]"}]}], ";", 
        RowBox[{"\[Sigma]i", "=", 
         SqrtBox[
          RowBox[{"Cumulant", "[", 
           RowBox[{"\[ScriptCapitalH]i", ",", "2"}], "]"}]]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\[Sigma]i", ",", "mPolyEsts", ",", 
          RowBox[{"\"\<(this is for peak \>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"4", "-", "i"}], "]"}], "<>", "\"\<)\>\""}]}], "}"}]}], 
       "\[IndentingNewLine]", ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{
         RowBox[{"Length", "[", "peakRanges", "]"}], "-", "1"}], ",", "1", 
        ",", 
        RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ")"}]}]], "Input",
