Cell[BoxData[
 RowBox[{
  RowBox[{"sampleLocalMax", "[", 
   RowBox[{"hList_", ",", "nSamp_", ",", "res_", ",", "smoothWidth_"}], "]"}],
   ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rSamp", "=", 
     RowBox[{"RandomSample", "[", 
      RowBox[{"hList", ",", "nSamp"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xSample", ",", "ySample"}], "}"}], "=", 
     RowBox[{"HistogramList", "[", 
      RowBox[{"rSamp", ",", 
       RowBox[{"{", "res", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"smoothY", "=", 
     RowBox[{"smooth", "[", 
      RowBox[{"ySample", ",", "smoothWidth"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"smoothX", "=", 
     RowBox[{"smooth", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"xSample", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;"}], "]"}], "]"}], "+", 
         RowBox[{"xSample", "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{"-", "2"}]}], "]"}], "]"}]}], "2"], ",", "smoothWidth"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"smoothData", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"smoothX", ",", "smoothY"}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"findXMax", "[", "smoothData", "]"}], ",", "smoothData"}], 
     "}"}]}], ")"}]}]], "Input",
