Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"PDF", "[", 
  RowBox[{
   RowBox[{"VoigtDistribution", "[", 
    RowBox[{"\[Delta]", ",", "\[Sigma]"}], "]"}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.7739961644060745`*^9, 3.77399618899096*^9}, {
  3.773996247790818*^9, 3.773996255240664*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"21bba18f-7c57-44c4-a99e-22eb0a44c731"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}], "+", "\[Delta]"}], 
        ")"}], "2"], 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
    RowBox[{"Erfc", "[", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}], "+", "\[Delta]"}], 
      RowBox[{
       SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}], "+", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "x"}], "+", "\[Delta]"}], ")"}], "2"], 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
    RowBox[{"Erfc", "[", 
     FractionBox[
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", "x"}], "+", "\[Delta]"}], 
      RowBox[{
       SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}]}], 
  RowBox[{"2", " ", 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]], " ", "\[Sigma]"}]]], "Output",
 CellChangeTimes->{3.7739961897507524`*^9, 3.7739962562010994`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"a0f3094e-93b0-45f8-8398-eda2d5712264"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
