Cell[BoxData[
 RowBox[{
  RowBox[{"skewedVoigt", "[", 
   RowBox[{
   "\[Mu]_", ",", "\[Delta]_", ",", "\[Sigma]_", ",", "skew_", ",", "x_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"VoigtDistribution", "[", 
      RowBox[{"\[Delta]", ",", "\[Sigma]"}], "]"}], ",", 
     RowBox[{"(", 
      RowBox[{"x", "-", "\[Mu]"}], ")"}]}], "]"}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"Erf", "[", 
      FractionBox[
       RowBox[{"skew", 
        RowBox[{"(", 
         RowBox[{"x", "-", "\[Mu]"}], ")"}]}], 
       RowBox[{"\[Sigma]", 
        SqrtBox["2"]}]], "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.7739963483817883`*^9, 3.7739964542427015`*^9}, {
  3.8013545422632694`*^9, 3.8013545444402127`*^9}},
 CellLabel->
  "In[384]:=",ExpressionUUID->"5e7cbf00-3e92-4456-b226-84894576793d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"skewedVoigt", "[", 
  RowBox[{"\[Mu]", ",", "\[Delta]", ",", "\[Sigma]", ",", "skew", ",", "x"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.7739964714529023`*^9, 3.7739964866051607`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"dc6e27c1-7335-4017-9e89-6325d150e3ec"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"Erf", "[", 
      FractionBox[
       RowBox[{"skew", " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "\[Mu]"}], ")"}]}], 
       RowBox[{
        SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}], "+", "\[Delta]"}], 
          ")"}], "2"], 
        RowBox[{"2", " ", 
         SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
      RowBox[{"Erfc", "[", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}], "+", "\[Delta]"}], 
        RowBox[{
         SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[ImaginaryI]", " ", "x"}], "+", "\[Delta]"}], ")"}], 
         "2"], 
        RowBox[{"2", " ", 
         SuperscriptBox["\[Sigma]", "2"]}]]], " ", 
      RowBox[{"Erfc", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "x"}], "+", "\[Delta]"}], 
        RowBox[{
         SqrtBox["2"], " ", "\[Sigma]"}]], "]"}]}]}], ")"}]}], 
  RowBox[{"2", " ", 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]], " ", "\[Sigma]"}]]], "Output",
 CellChangeTimes->{3.7739964873326406`*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"d836f2ba-3853-4cda-8416-4b04452ecbe3"]
}, Open  ]],

