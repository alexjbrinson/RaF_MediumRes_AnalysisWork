Cell[BoxData[
 RowBox[{
  RowBox[{"smooth", "[", 
   RowBox[{"lis_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", 
          RowBox[{"-", "w"}]}], "w"], 
        FractionBox["1", 
         RowBox[{
          RowBox[{"Abs", "[", "i", "]"}], "+", "1"}]]}]], 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", 
          RowBox[{
           RowBox[{"Abs", "[", "i", "]"}], "+", "1"}]], "*", 
         RowBox[{"lis", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"1", "+", "w", "+", "i"}], ";;", 
            RowBox[{
             RowBox[{"-", "1"}], "-", 
             RowBox[{"(", 
              RowBox[{"w", "-", "i"}], ")"}]}]}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"-", "w"}], ",", "w"}], "}"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"smoothedLis", "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{
        RowBox[{"2", "*", "w"}], "+", "1"}]], 
      RowBox[{"t", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.8013407386091146`*^9, 3.8013408770881977`*^9}, {
  3.801341832102853*^9, 3.8013418847507954`*^9}},
 CellLabel->
  "In[135]:=",ExpressionUUID->"557155d6-7b4d-425c-84c6-e66d1aa0efcf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"smoothY", "=", 
   RowBox[{"smooth", "[", 
    RowBox[{"ySamp", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"smoothX", "=", 
   RowBox[{"smooth", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"xSamp", "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;"}], "]"}], "]"}], "+", 
       RowBox[{"xSamp", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"-", "2"}]}], "]"}], "]"}]}], "2"], ",", "2"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"smoothDat", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"smoothX", ",", "smoothY"}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8013418874177456`*^9, 3.801341911094062*^9}, {
