Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"skewedVoigt", "[", 
   RowBox[{
   "\[Mu]_", ",", "\[Delta]_", ",", "\[Sigma]_", ",", "skew_", ",", "x_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"VoigtDistribution", "[", 
      RowBox[{"\[Delta]", ",", "\[Sigma]"}], "]"}], ",", 
     RowBox[{"(", 
      RowBox[{"x", "-", "\[Mu]"}], ")"}]}], "]"}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"Erf", "[", 
      FractionBox[
       RowBox[{"skew", 
        RowBox[{"(", 
         RowBox[{"x", "-", "\[Mu]"}], ")"}]}], 
       RowBox[{"\[Sigma]", 
        SqrtBox["2"]}]], "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"skewedVoigt", "[", 
    RowBox[{"0", ",", "1.5", ",", "1", ",", 
     RowBox[{"-", "2.5"}], ",", "x"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",
